# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD="1234"
DB_NAME=afmi
DB_SSL=false

# --- App ---
PORT=3000
NODE_ENV=development

# --- Vercel (serverless) ---
# VERCEL la define automáticamente Vercel en runtime (p. ej. "1"). No hace falta en .env local:
# con ella ausente, la app usa app.listen(PORT). Sólo documentación; no copies un valor salvo
# que quieras forzar el modo serverless en tu máquina para depurar.
# VERCEL=

# --- CORS (comma-separated origins; used for HTTP CORS and Socket.IO gateway) ---
CORS_ORIGIN=http://localhost:5173

# --- JWT (auth) ---
# JWT_SECRET: cambiar por un secreto largo y aleatorio en producción
JWT_SECRET=replace-with-a-long-random-secret
# JWT_EXPIRATION: duración del token (formato compatible con `ms`: 7d, 12h, 3600s, etc.)
JWT_EXPIRATION=7d

# --- Super Admin (usado por `npm run seed`) ---
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_EMAIL=admin@afmi.local
SUPER_ADMIN_PHONE=+5400000000000
SUPER_ADMIN_PASSWORD=ChangeMe123!
