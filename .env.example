# ===========================================================================
# afmi-backend — plantilla única de variables de entorno.
#
# Copia a `.env` y edita. Sirve para los tres escenarios; donde el valor cambia
# está anotado con [DOCKER] (producción con docker compose) y [DEV] (local).
#
#   local:   cp .env.example .env
#   docker:  make env            (hace el cp por ti)
#
# `.env` está en .gitignore: nunca lo subas al repo.
#
# En Docker, `docker-compose.yml` FUERZA estas tres — lo que pongas aquí no
# aplica dentro del contenedor: DB_HOST, NODE_ENV, PORT, MINIO_ENDPOINT.
# ===========================================================================

# --- Database ---
# [DEV] localhost
# [DOCKER] host.docker.internal — PostgreSQL corre en el host Ubuntu, FUERA del
# contenedor, y `localhost` apuntaría al contenedor mismo. Lo fuerza compose.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD="1234"
DB_NAME=afmi
DB_SSL=false

# --- App ---
PORT=3000
# [DEV] development · [DOCKER] production (lo fuerza compose)
NODE_ENV=development
# Zona horaria del proceso. La BD sigue guardando en UTC; esto afecta logs y el
# `timeZone` de los cron. En Docker la imagen ya trae TZ=America/Caracas.
TZ=America/Caracas

# --- CORS (coma-separada; HTTP + Socket.IO). Debe coincidir EXACTAMENTE con el Origin del navegador
# (esquema + host + puerto, sin barra final). En Vercel del backend: variable por entorno, p. ej.:
# CORS_ORIGIN=http://localhost:5173,https://tu-front.vercel.app
# Si el front usa fetch/axios con credentials, NO uses *; lista cada origen (local + producción + previews).
# [DOCKER] el dominio del front, p. ej. https://afmi.tudominio.com
CORS_ORIGIN=http://localhost:5173

# --- JWT (auth) ---
# JWT_SECRET: cambiar por un secreto largo y aleatorio en producción.
# Genera uno con: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
# JWT_EXPIRATION: duración del token (formato compatible con `ms`: 7d, 12h, 3600s, etc.)
JWT_EXPIRATION=7d

# --- Órdenes ---
# Número desde el cual empieza la secuencia auto-incremental de órdenes.
# Sólo se aplica si la secuencia actual está por debajo (nunca retrocede).
# Vacío o 1 → arranca en 1.
ORDER_NUMBER_START=1

# --- Cuentas por pagar / cobrar / retenciones ---
# Mismas reglas que ORDER_NUMBER_START. Se aplican a sequences propias
# `accounts_payable_seq`, `accounts_receivable_seq`, `taxes_payable_seq` y
# `tax_payment_batch_seq`.
PAYABLE_NUMBER_START=1
RECEIVABLE_NUMBER_START=1
TAX_PAYABLE_NUMBER_START=1
TAX_BATCH_NUMBER_START=1

# --- Impuesto del doctor (Paso 4 Facturación) ---
# Tasas decimales (0.03 = 3%). Aplican sólo cuando `Order.providerType === 'doctor'`.
# DOCTOR_NATURAL_TAX_RATE: persona natural.
# DOCTOR_LEGAL_TAX_RATE: persona jurídica (`isLegalEntity = true`).
# Expuesto al FE vía GET /config/tax-rates (público).
DOCTOR_NATURAL_TAX_RATE=0.03
DOCTOR_LEGAL_TAX_RATE=0.05

# --- Tasas BCV (cron de scraping) ---
# Lee https://www.bcv.org.ve/ y crea las filas de `exchange_rates` con la
# "Fecha Valor" publicada. Lunes a viernes, cada 15 min de 3:00 pm a 7:45 pm
# (hora de Venezuela) + recuperación a las 8:00 am. En serverless (Vercel) NO
# corre: ahí se usa `POST /exchange-rates/sync-bcv` a mano.
# [DOCKER] true (el valor de abajo, déjalo así)
# [DEV] ponlo en false para no ensuciar la BD local con tasas reales.
BCV_CRON_ENABLED=true
# Sincronizar una vez al arrancar el proceso (útil en el primer deploy).
BCV_SYNC_ON_BOOT=false
BCV_URL=https://www.bcv.org.ve/
BCV_HTTP_TIMEOUT_MS=25000
# El certificado del BCV tiene la cadena incompleta → Node lo rechaza.
# `true` acepta el TLS sin verificar sólo para ese host (lectura pública, no se
# envían credenciales). Pon `false` si el BCV arregla su certificado.
BCV_TLS_INSECURE=true

# --- Files / Storage: Vercel Blob (provider actual de `files/`) ---
# Token de Vercel Blob (https://vercel.com/docs/storage/vercel-blob). Requerido
# para que el módulo `files/` pueda emitir client tokens y borrar archivos.
# En Vercel: setear en el dashboard de Project Settings → Environment Variables.
# Sigue siendo el provider enlazado en FilesModule, también en Docker. Al
# implementar `MinioStorageProvider` se puede quitar (ver README-DOCKER.md).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXX

# --- Files / Storage: MinIO ([DOCKER] únicamente) ---
# Credenciales root del servicio `minio` del docker-compose. En local, si no
# corres MinIO, se pueden dejar como están: nada las usa todavía.
MINIO_ROOT_USER=afmi-admin
MINIO_ROOT_PASSWORD=cambia-esta-clave-minio-min-8-chars
MINIO_BUCKET=afmi-files
MINIO_REGION=us-east-1
# Endpoint interno de la red de Docker. Lo fuerza compose.
MINIO_ENDPOINT=http://minio:9000
# Endpoint público con el que el navegador sube/descarga por URL firmada. Debe
# apuntar al reverse proxy del host que publica el puerto 9000 de MinIO.
MINIO_PUBLIC_ENDPOINT=https://archivos.tudominio.com
# MinIO habla S3 con path-style, no virtual-host style.
MINIO_FORCE_PATH_STYLE=true

# --- Super Admin (usado por `npm run seed` / `make seed`) ---
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_EMAIL=admin@afmi.local
SUPER_ADMIN_PHONE=+5800000000000
SUPER_ADMIN_PASSWORD=ChangeMe123!
