# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD="1234"
DB_NAME=afmi
DB_SSL=false

# --- App ---
PORT=3000
NODE_ENV=development

# --- CORS (coma-separada; HTTP + Socket.IO). Debe coincidir EXACTAMENTE con el Origin del navegador
# (esquema + host + puerto, sin barra final). En Vercel del backend: variable por entorno, p. ej.:
# CORS_ORIGIN=http://localhost:5173,https://tu-front.vercel.app
# Si el front usa fetch/axios con credentials, NO uses *; lista cada origen (local + producción + previews).
CORS_ORIGIN=http://localhost:5173

# --- JWT (auth) ---
# JWT_SECRET: cambiar por un secreto largo y aleatorio en producción
JWT_SECRET=replace-with-a-long-random-secret
# JWT_EXPIRATION: duración del token (formato compatible con `ms`: 7d, 12h, 3600s, etc.)
JWT_EXPIRATION=7d

# --- Órdenes ---
# Número desde el cual empieza la secuencia auto-incremental de órdenes.
# Sólo se aplica si la secuencia actual está por debajo (nunca retrocede).
# Vacío o 1 → arranca en 1.
ORDER_NUMBER_START=1

# --- Cuentas por pagar / cobrar ---
# Mismas reglas que ORDER_NUMBER_START. Se aplican a sequences propias
# `accounts_payable_seq` y `accounts_receivable_seq`.
PAYABLE_NUMBER_START=1
RECEIVABLE_NUMBER_START=1

# --- Impuesto del doctor (Paso 4 Facturación) ---
# Tasas decimales (0.03 = 3%). Aplican sólo cuando `Order.providerType === 'doctor'`.
# DOCTOR_NATURAL_TAX_RATE: persona natural.
# DOCTOR_LEGAL_TAX_RATE: persona jurídica (`isLegalEntity = true`).
# Expuesto al FE vía GET /config/tax-rates (público).
DOCTOR_NATURAL_TAX_RATE=0.03
DOCTOR_LEGAL_TAX_RATE=0.05

# --- Super Admin (usado por `npm run seed`) ---
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_EMAIL=admin@afmi.local
SUPER_ADMIN_PHONE=+5400000000000
SUPER_ADMIN_PASSWORD=ChangeMe123!
